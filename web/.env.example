# Copy to .env and fill in. Never commit .env — only this template.
#
# Validated by src/server/env.ts at module scope, so a missing or malformed
# required value throws on import rather than failing at the first query.
# That also means these must be present when the app is BUILT, not only when
# it runs — set them for every environment your host builds, previews included.

# ---------------------------------------------------------------- required --

# Postgres connection string.
#   Local:  createdb lipi_dev, then use the line below with your own username.
#   Hosted: on a serverless host point this at a POOLED connection
#           (Neon, or Supabase's pooler on :6543) — every cold function opens
#           its own connection.
DATABASE_URL="postgresql://USER@localhost:5432/lipi_dev"

# Encrypts channel and connector credentials at rest. Minimum 16 characters.
# Generate once with: openssl rand -base64 32
# Rotating it invalidates every stored credential — each connected channel and
# inventory connector then has to be reconnected. Not a casual change.
APP_SECRET=

# ---------------------------------------------------------------- optional --

# This deployment's own public origin: where the outside world reaches this
# app. Provider webhook URLs and connector push URLs are built from it, and
# nothing else is — a server component calling this app's own API goes to
# loopback, so pointing this at a tunnel no longer sends server-rendered
# pages out over the internet and back.
# For real inbound webhooks in development, use a tunnel (ngrok, cloudflared).
# Default: http://localhost:3000
PUBLIC_URL=http://localhost:3000

# Where this app reaches ITSELF, if 127.0.0.1 is not the answer. Server
# components fetch their own route handlers, and on a host that cannot serve
# itself on loopback that fetch needs a name. Vercel is detected already.
# Leave unset anywhere loopback works, which includes local development.
# Default: http://127.0.0.1:$PORT
# INTERNAL_URL=

# Enables model-backed intent extraction and the operator's "Ask the twin"
# chat. Without a key, extraction falls back to a deterministic rule extractor
# — the ingest loop stays fully functional, just less tolerant of ambiguous
# phrasing — and twin-chat is unavailable.
OPENROUTER_API_KEY=

# Runs on every inbound customer message and decides whether stock gets
# reserved. Default: deepseek/deepseek-v4-flash
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Backs the operator's own twin chat only: a handful of calls a day over a long
# briefing, so it can afford to be slower and stronger than the extractor.
# Default: nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# development | test | production. Default: development
NODE_ENV=development

# ---------------------------------------------------------------- composio --

# Composio holds every channel credential and runs every outbound send. One
# project per environment; the API key is created in its Settings page.
# Without it every channel is listed as unavailable and webchat still works.
COMPOSIO_API_KEY=

# Signs each webhook Composio delivers to PUBLIC_URL/webhooks/composio.
# Printed exactly once by `npm run composio:subscribe` (rotate to see a new
# one); a wrong or missing value makes every delivery a 401.
COMPOSIO_WEBHOOK_SECRET=

# One auth config id (`ac_…`) per channel, from the project's Auth Configs
# page or `docs/runbooks/composio-project.md`. Leave a channel blank to keep
# it out of the catalog. WhatsApp's is an API_KEY config (the operator pastes
# a system-user token and WABA id); Instagram and Messenger must be custom
# OAuth configs on Lipi's own Meta app before they can go live — see
# docs/runbooks/meta-app.md.
COMPOSIO_AUTH_CONFIG_WHATSAPP=
COMPOSIO_AUTH_CONFIG_INSTAGRAM=
COMPOSIO_AUTH_CONFIG_FACEBOOK=
COMPOSIO_AUTH_CONFIG_TELEGRAM=
COMPOSIO_AUTH_CONFIG_X=
COMPOSIO_AUTH_CONFIG_GMAIL=

# Lipi's own Meta app, which every WhatsApp, Instagram and Messenger tenant
# subscribes through. The App Secret verifies the signature on every inbound
# body; the verify token is what Meta echoes when PUBLIC_URL/webhooks/meta is
# registered as the callback. Both are REQUIRED as soon as any of the three
# Meta auth config ids above is set — the app refuses to boot otherwise,
# because a Meta channel whose webhooks cannot be verified receives nothing
# and says nothing about it.
META_APP_SECRET=
META_VERIFY_TOKEN=

# ----------------------------------------------------------------------- X --

# Lipi's own X app, which every X tenant's direct messages arrive through.
# X registers a webhook against an app rather than an account, so there is one
# of each for the deployment:
#   X_API_SECRET  the app's consumer secret (API secret key, NOT the bearer
#                 token). It verifies the signature on every Account Activity
#                 delivery and answers the hourly challenge on
#                 PUBLIC_URL/webhooks/x.
#   X_WEBHOOK_ID  the id returned by `POST /2/webhooks` when that URL was
#                 registered. Each connecting tenant's activity is subscribed
#                 to it.
# Both are REQUIRED as soon as COMPOSIO_AUTH_CONFIG_X is set — the app refuses
# to boot otherwise, because an X channel whose deliveries cannot be verified
# receives nothing and says nothing about it. Account Activity access is a
# paid X tier and DMs are billed per message.
X_API_SECRET=
X_WEBHOOK_ID=

# ----------------------------------------------------------------- Shopify --

# Lipi's own Shopify app, one per deployment, created in the Shopify Partner
# dashboard. The API key identifies it on the consent screen; the secret both
# signs the OAuth callback and every webhook body, exactly as META_APP_SECRET
# does for Meta. Set both or neither — half an app is an install that starts
# and cannot finish. The app's redirect URL must be
# PUBLIC_URL/v1/inventory/shopify/callback.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# What the operator is asked to consent to, and the Admin API version every
# call is pinned to. Both have working defaults; override to widen the scopes
# or to move the deployment to a newer version deliberately.
# SHOPIFY_SCOPES="read_products,read_inventory,read_orders"
# SHOPIFY_API_VERSION="2025-01"

# ------------------------------------------------------------------- tests --

# `npm test` runs against its own database, created once with:
#   createdb lipi_test
# The setup file refuses to run against anything not named lipi_test, so a
# stray DATABASE_URL cannot wipe development data.
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/lipi_test"
