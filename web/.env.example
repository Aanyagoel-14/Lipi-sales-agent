# Copy to .env and fill in. Never commit .env — only this template.
#
# Validated by src/server/env.ts at module scope, so a missing or malformed
# required value throws on import rather than failing at the first query.
# That also means these must be present when the app is BUILT, not only when
# it runs — set them for every environment your host builds, previews included.

# ---------------------------------------------------------------- required --

# Postgres connection string.
#   Local:  createdb lipi_dev, then use the line below with your own username.
#   Hosted: on a serverless host point this at a POOLED connection
#           (Neon, or Supabase's pooler on :6543) — every cold function opens
#           its own connection.
DATABASE_URL="postgresql://USER@localhost:5432/lipi_dev"

# Encrypts channel and connector credentials at rest. Minimum 16 characters.
# Generate once with: openssl rand -base64 32
# Rotating it invalidates every stored credential — each connected channel and
# inventory connector then has to be reconnected. Not a casual change.
APP_SECRET=

# ---------------------------------------------------------------- optional --

# This deployment's own public origin. Provider webhook URLs and connector
# push URLs are built from it, and server components resolve their own API
# calls against it — so in local development it must point at localhost, or
# server-rendered pages will fetch your deployed app instead.
# For real inbound webhooks in development, use a tunnel (ngrok, cloudflared).
# Default: http://localhost:3000
PUBLIC_URL=http://localhost:3000

# Enables model-backed intent extraction and the operator's "Ask the twin"
# chat. Without a key, extraction falls back to a deterministic rule extractor
# — the ingest loop stays fully functional, just less tolerant of ambiguous
# phrasing — and twin-chat is unavailable.
OPENROUTER_API_KEY=

# Runs on every inbound customer message and decides whether stock gets
# reserved. Default: deepseek/deepseek-v4-flash
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Backs the operator's own twin chat only: a handful of calls a day over a long
# briefing, so it can afford to be slower and stronger than the extractor.
# Default: nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# development | test | production. Default: development
NODE_ENV=development

# ---------------------------------------------------------------- composio --

# Composio holds every channel credential and runs every outbound send. One
# project per environment; the API key is created in its Settings page.
# Without it every channel is listed as unavailable and webchat still works.
COMPOSIO_API_KEY=

# Signs each webhook Composio delivers to PUBLIC_URL/webhooks/composio.
# Printed exactly once by `npm run composio:subscribe` (rotate to see a new
# one); a wrong or missing value makes every delivery a 401.
COMPOSIO_WEBHOOK_SECRET=

# One auth config id (`ac_…`) per channel, from the project's Auth Configs
# page or `docs/runbooks/composio-project.md`. Leave a channel blank to keep
# it out of the catalog. WhatsApp and Instagram must be custom auth configs on
# Lipi's own Meta app before they can go live — see docs/runbooks/meta-app.md.
COMPOSIO_AUTH_CONFIG_WHATSAPP=
COMPOSIO_AUTH_CONFIG_INSTAGRAM=
COMPOSIO_AUTH_CONFIG_TELEGRAM=
COMPOSIO_AUTH_CONFIG_GMAIL=

# Lipi's own Meta app, which every WhatsApp and Instagram tenant subscribes
# through. The App Secret verifies inbound webhook signatures; the verify
# token is what Meta echoes when the callback URL is registered. Both are
# needed once the Meta webhook route ships; harmless to set earlier.
META_APP_SECRET=
META_VERIFY_TOKEN=

# ------------------------------------------------------------------- tests --

# `npm test` runs against its own database, created once with:
#   createdb lipi_test
# The setup file refuses to run against anything not named lipi_test, so a
# stray DATABASE_URL cannot wipe development data.
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/lipi_test"
