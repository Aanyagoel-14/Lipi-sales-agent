// Lipi AI — the twins, persisted.
//
// Shapes mirror what the dashboard already consumes, so the API can answer
// from Postgres without the frontend changing. Money is stored in paise
// (integer minor units) rather than floats: currency arithmetic that has to
// reconcile must never round.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 takes the connection URL from prisma.config.ts for migrate, and
// from the driver adapter passed to PrismaClient at runtime.
datasource db {
  provider = "postgresql"
}

enum Channel {
  whatsapp
  instagram
  facebook
  telegram
  /// X (formerly Twitter) direct messages.
  x
  email
  webchat
}

enum Segment {
  Retail
  Wholesale
  Corporate
}

enum Sensitivity {
  Low
  Medium
  High
}

enum OrderStage {
  Quoted
  Paid
  Packed
  Shipped
  Delivered
  Returned
}

enum RunStatus {
  done
  needs_approval
  scheduled
  failed
}

enum Severity {
  routine
  attention
  policy
}

enum InvoiceSource {
  quickbooks
  zoho
  manual
}

enum PaymentMethod {
  bank_transfer
  card
  upi
  cash
}

model Customer {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id               String      @id
  name             String
  handle           String
  channel          Channel
  segment          Segment
  lifetimeValue    Int
  orderCount       Int
  avgOrderValue    Int
  returnRatePct    Float
  priceSensitivity Sensitivity
  negotiationStyle String
  sizeProfile      String[]
  predictedNext    String
  riskScore        Int
  lastSeenAt       DateTime

  /// Where this business relationship started, in the ad platform's own
  /// vocabulary: UTM parameters and a click id (gclid/fbclid/msclkid),
  /// captured once at the visitor's first touch and never overwritten by a
  /// later visit — a returning customer who clicks a retargeting ad a month
  /// later does not get re-attributed to that ad. Null for a customer who
  /// never arrived via a tracked link (a channel with no URL, or a direct
  /// visit with no query string).
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  adClickId    String?
  landingPage  String?
  referrer     String?
  firstTouchAt DateTime?

  /// A running estimate of purchase intent, recomputed after every inbound
  /// message (see `services/leads.ts`). Not a prediction of lifetime value —
  /// `riskScore` and `predictedNext` already speak to that — this is
  /// specifically "how close is this conversation to becoming an order",
  /// which is what a growth or sales operator triaging a lead list needs.
  leadScore Int       @default(0)
  leadStage LeadStage @default(visitor)

  /// How to reach this person outside the thread they arrived in. A webchat
  /// visitor's `handle` is `web:<visitorId>` — an opaque token their browser
  /// minted — so without these a qualified website lead is unreachable.
  ///
  /// Each carries its own provenance and the moment it landed, because the
  /// two ways they arrive are not equally trustworthy: `volunteered` was
  /// pattern-matched out of something the visitor typed in conversation,
  /// `form` was typed into the widget's own field with a label on it. Null
  /// means nobody has given it, which is what stops the twin asking twice.
  ///
  /// Not unique. An email already on another twin in this workspace is a
  /// flag for the operator, never a merge — see `services/contacts.ts`.
  email       String?
  emailSource ContactSource?
  emailAt     DateTime?
  phone       String?
  phoneSource ContactSource?
  phoneAt     DateTime?

  orders            Order[]
  conversations     Conversation[]
  invoices          Invoice[]
  payments          Payment[]
  growthSuggestions GrowthSuggestion[]
  modelCalls        ModelCall[]

  @@index([segment])
  @@index([workspaceId])
  @@index([workspaceId, leadStage])
  @@index([workspaceId, utmCampaign])
  @@index([workspaceId, email])
  @@map("customers")
}

/**
 * Where a contact detail came from. `volunteered` was recognised by pattern
 * in a message the visitor wrote for some other reason ("mail me at x@y.com");
 * `form` was typed into the widget's own labelled field. The operator reading
 * a lead list needs to tell them apart: one is an address the person chose to
 * give, the other is one we read out of their prose.
 */
enum ContactSource {
  volunteered
  form
}

/**
 * Where a lead sits on the way to being a customer. Ordered, but not a
 * strict pipeline a lead must step through one stage at a time — `orders`
 * already exists as ground truth, so a customer who orders on their very
 * first message goes straight to `customer` without pausing at `qualified`.
 */
enum LeadStage {
  visitor
  engaged
  qualified
  customer
}

model Supplier {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id            String    @id
  name          String
  onTimePct     Int
  avgLeadDays   Int
  defectRatePct Float
  moq           Int
  responseHours Int
  products      Product[]

  @@index([workspaceId])
  @@map("suppliers")
}

model Product {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id           String   @id
  name         String
  category     String
  /// What the two variant axes are called for this vertical: apparel sells by
  /// Size and Colour, auto parts by Fitment and Grade. The twin is only
  /// variant-native if the axes come from the business, not from a guess.
  axes         String[]
  /// Vertical-specific attributes (fabric and season for apparel, OEM ref and
  /// warranty for parts). Kept as JSON so a new vertical needs no migration.
  attributes   Json     @default("{}")
  price        Int
  marginPct    Int
  leadTimeDays Int
  crossSell    String[]

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  variants Variant[]
  orders   Order[]

  @@index([supplierId])
  @@index([workspaceId])
  @@map("products")
}

model Variant {
  id       String @id @default(cuid())
  /// Values on the product's two axes, in the same order as Product.axes.
  optionA  String
  optionB  String
  stock    Int
  reserved Int
  /// Generated once at creation from the product name and options then
  /// stored (L-1d fix). Previously rebuilt on every read from the *current*
  /// name/options, so renaming a product silently changed every variant's
  /// SKU and broke anything that had written the old one down — an
  /// inventory connector's mapping, a past event payload. Backfilled for
  /// rows that predate this column; a rename after that point never touches
  /// it again.
  sku      String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  inventoryMappings InventoryMapping[]
  orders            Order[]

  // One row per size/colour per product: the twin is variant-native.
  @@unique([productId, optionA, optionB])
  @@unique([productId, sku])
  @@index([stock])
  @@map("variants")
}

model Order {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id        String     @id
  /// Display label, `${optionA} / ${optionB}` at the time of order. Kept
  /// verbatim even if the variant is later renamed, so history reads true.
  variant   String
  qty       Int
  value     Int
  stage     OrderStage
  channel   Channel
  createdAt DateTime
  blocked   String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  /// The actual variant row, so fulfilment can settle stock and reservations
  /// without re-parsing the display label.
  variantId  String
  variantRef Variant  @relation(fields: [variantId], references: [id])

  invoices Invoice[]

  @@index([stage])
  @@index([customerId])
  @@index([workspaceId])
  @@index([variantId])
  @@map("orders")
}

model Conversation {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id      String   @id
  channel Channel
  subject String
  unread  Boolean
  lastAt  DateTime
  intent  String
  signals Json

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  messages Message[]
  runs     AgentRun[]

  @@index([lastAt])
  @@index([workspaceId])
  @@map("conversations")
}

/**
 * What became of an agent message after it was written.
 *
 * The distinction that matters is `sent` versus everything else: a message is
 * only ever `sent` once a provider has accepted it. Before the Composio track
 * the inbox showed every drafted reply as though it had gone out, which is the
 * one thing a shared inbox must not do.
 */
enum DeliveryStatus {
  /// Customer messages, and agent messages from before this was tracked.
  not_applicable
  /// Handed to the send path; no answer from the provider yet.
  pending
  sent
  /// The provider refused it, or the channel could not carry it.
  failed
  /// Drafted under an approval policy and never released.
  held
}

model Message {
  id     String   @id @default(cuid())
  from   String
  text   String
  sentAt DateTime
  quote  Json?
  /// Whether this message actually reached the customer. Only agent messages
  /// are ever delivered, so a customer message stays `not_applicable` --
  /// as do agent messages written before delivery was tracked.
  deliveryStatus DeliveryStatus @default(not_applicable)
  /// The provider's own reason, when it refused. Shown to the operator.
  deliveryError  String?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("messages")
}

model AgentRun {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id         String    @id
  /// The acting agent's display name. Kept as a string, not narrowed to a
  /// foreign key, because `ingest()`'s own four roles ("Sales", "Inventory",
  /// "Procurement", "Support") are not rows and never were — a run raised by
  /// the built-in commerce loop has a name and no `agentId`.
  agent      String
  action     String
  status     RunStatus
  durationMs Int
  ranAt      DateTime

  /// The configured agent this run belongs to, when one does. Null for the
  /// built-in loop above.
  agentId String?
  agentRef Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  /// The registry slug of the skill that produced this run, when a skill did.
  /// Null for the built-in loop. This is what makes "which tool did the model
  /// actually invoke, and with whose authority" answerable from the audit
  /// trail rather than from prose in `action`.
  skill String?

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  approval Approval?

  @@index([status])
  @@index([ranAt])
  @@index([workspaceId])
  @@index([agentId, ranAt])
  @@map("agent_runs")
}

model Approval {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id       String   @id
  agent    String
  summary  String
  detail   String
  impact   String
  raisedAt DateTime
  severity Severity

  runId String   @unique
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("approvals")
}

model TwinEvent {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id         String   @id
  occurredAt DateTime
  type       String
  twin       String
  payload    String

  // Append only. Nothing in the app updates or deletes these.
  @@index([occurredAt])
  @@index([twin])
  @@index([workspaceId])
  @@map("twin_events")
}

model Invoice {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  number   String        @id
  source   InvoiceSource
  issuedOn DateTime      @db.Date
  dueOn    DateTime      @db.Date
  amount   Int

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])

  payments Payment[]

  @@index([dueOn])
  @@index([workspaceId])
  @@map("invoices")
}

model Payment {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id         String        @id
  receivedAt DateTime
  method     PaymentMethod
  reference  String?
  loggedBy   String
  amount     Int

  invoiceNumber String
  invoice       Invoice  @relation(fields: [invoiceNumber], references: [number], onDelete: Cascade)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])

  @@index([invoiceNumber, receivedAt])
  @@index([workspaceId])
  @@map("payments")
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  company   String?
  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}

enum Vertical {
  apparel
  auto_parts
  marine
  wholesale
}

/**
 * How much an agent may do before a human sees it.
 */
enum ApprovalPolicy {
  everything
  money_only
  nothing
}

enum Role {
  owner
  member
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

model Membership {
  id   String @id @default(cuid())
  role Role   @default(owner)

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

/**
 * Opaque server-side sessions. The cookie carries an id, never a claim.
 */
model Session {
  id        String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Workspace {
  id              String         @id @default(cuid())
  name            String
  vertical        Vertical
  channels        Channel[]
  approvalPolicy  ApprovalPolicy @default(money_only)
  catalogueSeeded Boolean        @default(false)
  onboardedAt     DateTime?
  createdAt       DateTime       @default(now())

  /// Browser origins allowed to call `/v1` with this workspace's API key.
  /// Empty by default: a key-authenticated cross-origin call is a different
  /// trust question from the anonymous widget, which stays `*`. See
  /// `server/lib/cors.ts`.
  allowedOrigins  String[]       @default([])

  /// What this workspace may spend on language models, and the unit each
  /// ceiling is counted in. Both daily ceilings reset at UTC midnight and are
  /// counted over `model_calls`, so they survive a restart and are shared by
  /// every process — unlike `lib/rate-limit.ts`, which bounds requests per IP
  /// in one process's memory and says nothing about spend.
  ///
  /// A call ceiling as well as a token one, because a failing call reports no
  /// tokens: a wrong API key would otherwise burn an unbounded number of
  /// billable attempts without ever moving the token total. Zero on either is
  /// a kill switch — every model-backed path degrades to its deterministic
  /// one, which is what an absent key already does.
  dailyModelCalls  Int @default(2000)
  dailyModelTokens Int @default(1000000)
  /// And within the day, what one customer's thread may take of it, so a
  /// single scripted visitor cannot spend the whole workspace's budget.
  customerModelCalls Int @default(60)

  voice               TwinVoice?
  knowledge           KnowledgeEntry[]
  examples            VoiceExample[]
  memberships         Membership[]
  connections         ChannelConnection[]
  inventoryConnectors InventoryConnector[]

  customers         Customer[]
  suppliers         Supplier[]
  products          Product[]
  orders            Order[]
  conversations     Conversation[]
  agentRuns         AgentRun[]
  approvals         Approval[]
  twinEvents        TwinEvent[]
  invoices          Invoice[]
  payments          Payment[]
  visitorSessions   VisitorSession[]
  growthSuggestions GrowthSuggestion[]
  apiKeys           ApiKey[]

  webhookSubscriptions WebhookSubscription[]
  webhookDeliveries    WebhookDelivery[]
  modelCalls           ModelCall[]
  agents               Agent[]
  paProfiles           PaProfile[]
  negotiations         SchedulingNegotiation[]
  sites                GeneratedSite[]

  @@map("workspaces")
}

enum Formality {
  formal
  neutral
  friendly
}

enum Length {
  terse
  balanced
  detailed
}

/**
 * How the agents sound. Separate from what they know: voice governs phrasing,
 * knowledge governs claims, and mixing the two is how you get an assistant
 * that sounds right while saying something false.
 */
model TwinVoice {
  id        String    @id @default(cuid())
  formality Formality @default(friendly)
  length    Length    @default(balanced)
  useEmoji  Boolean   @default(false)
  signOff   String?
  languages String[]  @default(["English"])
  greeting  String?
  neverSay  String[]  @default([])
  alwaysSay String[]  @default([])
  updatedAt DateTime  @updatedAt

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("twin_voice")
}

enum KnowledgeKind {
  policy
  faq
  sizing
  shipping
  warranty
  pricing
}

/**
 * What the twin is allowed to assert. Agents answer from these, not guesswork.
 */
model KnowledgeEntry {
  id        String        @id @default(cuid())
  kind      KnowledgeKind
  title     String
  body      String
  createdAt DateTime      @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind])
  @@map("knowledge_entries")
}

/**
 * Few-shot pairs: this is how we would answer that. Trains tone, not facts.
 */
model VoiceExample {
  id           String   @id @default(cuid())
  customerSays String
  twinReplies  String
  createdAt    DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("voice_examples")
}

enum ConnectionStatus {
  disconnected
  /// A Connect Link was issued and the callback has not been seen yet.
  pending
  connected
  /// Composio reported the account expired, a trigger was disabled, or a
  /// send failed on auth. The operator has to go through connect again.
  needs_reconnect
  error
}

/**
 * A channel the workspace has actually connected.
 *
 * Since the Composio track the sending credential is not here: Composio holds
 * it against `composioAccountId` and Lipi executes tools against that account.
 * What remains is what inbound needs -- the provider's own identifier to route
 * on, and the secrets that prove a webhook really came from the provider.
 */
model ChannelConnection {
  id                  String           @id @default(cuid())
  channel             Channel
  status              ConnectionStatus @default(disconnected)
  /// Provider identity: phone number id, bot username, mailbox address.
  externalId          String?
  displayName         String?
  /// Non-secret settings, safe to show back to the operator.
  config              Json             @default("{}")
  /// The Composio connected account that holds this channel's credentials,
  /// and the auth config it was created under. Globally unique: one account
  /// belongs to one connection.
  composioAccountId    String?   @unique
  composioAuthConfigId String?
  /// Trigger instances Lipi created for this account; deleted on disconnect.
  composioTriggerIds   String[]  @default([])
  connectedAt          DateTime?
  /// Proves an inbound webhook came from the provider. Telegram only: the
  /// `secret_token` Lipi generates for `setWebhook` and Telegram echoes in
  /// `x-telegram-bot-api-secret-token` on every delivery. Cleared on
  /// disconnect, which is what stops a webhook Lipi can no longer withdraw.
  /// Meta channels keep nothing here: their bodies are signed with Lipi's
  /// own app-level META_APP_SECRET and their GET challenge is answered
  /// against the deployment's META_VERIFY_TOKEN, so no per-tenant provider
  /// secret is stored for them at all.
  webhookSecret       String?
  lastEventAt         DateTime?
  lastError           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  processedMessages ProcessedMessage[]

  @@unique([workspaceId, channel])
  // Inbound is routed by the provider's own id (phone_number_id, IG account
  // id, Page id, bot id, mailbox) with no workspace in the URL, so an id has
  // to resolve to exactly one workspace.
  @@unique([channel, externalId])
  @@index([workspaceId])
  @@map("channel_connections")
}

/**
 * H-3 fix: inbound provider message-id idempotency.
 * Channel adapters already parse a provider's own message id
 * (`InboundMessage.externalId`); the webhook route used to discard it, so a
 * provider retry (the same webhook POST, resent because our 200 was slow or
 * dropped) ran the full ingest loop a second time -- duplicating orders and
 * reservations for one real customer message. Recording the id here, and
 * checking it before calling `ingest()`, makes a retry a no-op.
 * Scoped to the connection rather than the workspace: two different channels
 * could coincidentally reuse the same provider-assigned id, and a connection
 * is already workspace-scoped.
 */
model ProcessedMessage {
  id         String   @id @default(cuid())
  externalId String
  receivedAt DateTime @default(now())

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, receivedAt])
  @@map("processed_messages")
}

/**
 * ------------------------------- webchat + growth ---------------------------
 */

/**
 * An anonymous visitor to the workspace's own website, from the moment the
 * webchat widget loads until they say something (or leave without ever
 * messaging).
 * This exists separately from `Customer` because a visitor is not yet a
 * lead: most page loads never open the chat, and creating a customer row for
 * every one of them would make the customer list mean nothing. A session
 * only gains a `customerId` once the visitor actually sends a message —
 * that is the moment `ingest()` creates or resolves their customer twin.
 * Attribution is captured here, at the *first* page the widget ever loaded
 * on, because that is the only moment the ad platform's own query
 * parameters are present in the URL. By the time a visitor replies to a
 * proactive engagement message three page views later, `gclid` is long
 * gone from the address bar — the widget cannot fetch what the browser no
 * longer has. So the widget sends what it sees once, on load, and this row
 * is engagement/attribution's own source of truth. This first-touch record
 * is copied onto the `Customer` row when one is created, and never
 * overwritten by a later session (see `services/attribution.ts`).
 */
model VisitorSession {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Opaque id the widget itself mints and keeps in localStorage. Not a
  /// customer id — the same visitor may open the widget several times
  /// before ever messaging, and all of those loads share this row.
  visitorId   String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  adClickId   String?
  landingPage String?
  referrer    String?
  /// Set the moment this visitor sends their first message and a customer
  /// twin exists for them. Null for a session that never engaged.
  customerId  String?
  engagedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@unique([workspaceId, visitorId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, customerId])
  @@map("visitor_sessions")
}

/**
 * A drafted next step for a lead that has gone quiet, surfaced to the
 * operator rather than sent automatically — the same caution as a purchase
 * order (C-1): a nudge is a real message to a real prospect, so a human
 * approves the wording before it goes out. `dismissedAt` lets an operator
 * clear a suggestion without acting on it, so the list only ever shows
 * live work.
 */
model GrowthSuggestion {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind        String
  headline    String
  detail      String
  draftReply  String
  createdAt   DateTime  @default(now())
  dismissedAt DateTime?
  actedAt     DateTime?

  @@unique([workspaceId, customerId, kind])
  @@index([workspaceId, dismissedAt, actedAt])
  @@map("growth_suggestions")
}

/**
 * --------------------------- inventory connectors --------------------------
 */

enum InventorySource {
  shopify
  woocommerce
  zoho
  erp
  pos
  custom
}

enum SyncStatus {
  applied
  partial
  failed
}

enum ExceptionKind {
  unmapped_sku
  ambiguous_sku
  unknown_variant
  invalid_quantity
  below_reserved
}

/**
 * A live inventory feed.
 * CSV import is a snapshot: correct the moment it is taken and wrong the
 * moment anything sells. A connector is what keeps the inventory twin current,
 * so the twin can refuse to promise stock it does not have.
 * The source pushes batches to /v1/inventory/sync authenticated by this row's
 * own secret, because an ERP has no user session. Corrections land through the
 * same path as a manual one and append the same events.
 */
model InventoryConnector {
  id     String           @id @default(cuid())
  source InventorySource
  name   String
  status ConnectionStatus @default(disconnected)

  /// Bearer token hash. The plaintext is shown once at creation and never again.
  secretHash String
  /// Opaque position in the source's change feed, echoed back on each batch:
  /// an updated_at watermark, a page token, a Shopify `since_id`. The source
  /// owns its meaning; we only hand back what it last gave us so a resumed
  /// sync does not restart from the beginning.
  cursor     String?

  lastSyncAt   DateTime?
  lastError    String?
  /// Counters since the connector was created, for the operator's health view.
  appliedCount Int       @default(0)
  failedCount  Int       @default(0)

  /// The source's own identity for the store this connector speaks to, when
  /// the source is one Lipi calls rather than one that calls Lipi. Shopify
  /// puts `acme.myshopify.com` here; a pushed connector leaves it null.
  /// Globally unique because an inbound webhook names only the shop, with no
  /// workspace in the URL, so a shop has to resolve to exactly one connector.
  externalId   String?
  /// OAuth access token, encrypted at rest through `lib/crypto` exactly as a
  /// channel credential is. Never returned by an endpoint, never logged.
  /// Cleared on disconnect, which is what stops a token outliving the
  /// operator's decision to unplug the store.
  accessToken  String?
  /// The scopes the provider actually granted, so a feature that needs one
  /// can say which re-consent it needs rather than failing on a 403.
  scopes       String[]  @default([])
  /// Anti-CSRF nonce for an install in flight. Written when the operator is
  /// sent to the provider's consent screen, required to match on the way
  /// back, and cleared the moment it is spent.
  installState String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  mappings   InventoryMapping[]
  runs       InventorySyncRun[]
  exceptions InventoryException[]

  // One connector per source per workspace: two feeds for the same system
  // would fight over the same variants.
  @@unique([workspaceId, source])
  @@unique([externalId])
  @@index([workspaceId])
  @@map("inventory_connectors")
}

/**
 * External SKU to variant. The source knows its own SKUs and nothing about our
 * two-axis variants, so the mapping is explicit rather than inferred — a wrong
 * guess here corrects the stock of the wrong sellable thing.
 */
model InventoryMapping {
  id          String   @id @default(cuid())
  externalSku String
  /// A second handle the same source uses for the same sellable thing.
  /// Shopify splits a variant's identity in two: it is sold by `variant.id`
  /// and stocked by `inventory_item_id`, and `inventory_levels/update`
  /// carries only the latter. One row per variant with both handles keeps
  /// the operator's mapping list one line per thing they sell, rather than
  /// two rows that look like two products.
  externalRef String?
  createdAt   DateTime @default(now())

  connectorId String
  connector   InventoryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant            @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([connectorId, externalSku])
  @@unique([connectorId, externalRef])
  @@index([variantId])
  @@map("inventory_mappings")
}

/**
 * One pushed batch.
 * `idempotencyKey` is the contract with the source: a network timeout means it
 * must be able to retry, and a retry must not apply the same corrections
 * twice. Replaying a key returns the original outcome instead of re-running.
 */
model InventorySyncRun {
  id             String     @id @default(cuid())
  idempotencyKey String
  status         SyncStatus
  /// Rows received, applied, and rejected into the exception queue.
  received       Int
  applied        Int
  rejected       Int
  /// The cursor the source sent with this batch, kept for reconciliation.
  cursor         String?
  startedAt      DateTime   @default(now())
  durationMs     Int        @default(0)
  error          String?
  /// The applied corrections, for replay and for answering "why did this move".
  changes        Json       @default("[]")

  connectorId String
  connector   InventoryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, idempotencyKey])
  @@index([connectorId, startedAt])
  @@map("inventory_sync_runs")
}

/**
 * A row the connector could not apply.
 * Silently dropping it would let the twin drift while the dashboard claimed a
 * healthy sync, so it becomes operator-visible work: map the SKU, or dismiss
 * the row. Unresolved exceptions are the honest answer to "is my stock right".
 */
model InventoryException {
  id          String        @id @default(cuid())
  kind        ExceptionKind
  externalSku String
  /// What the source claimed, kept verbatim so the operator can judge it.
  payload     Json
  detail      String
  raisedAt    DateTime      @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  connectorId String
  connector   InventoryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId, resolvedAt])
  @@map("inventory_exceptions")
}

enum ApiScope {
  read
  write
}

/**
 * A server-to-server credential for `/v1`.
 *
 * The secret is minted once and stored only as a SHA-256 hash, the same shape
 * `InventoryConnector.secretHash` already uses — the difference is that a key
 * is looked up *by* its hash, so presenting one costs a single indexed read
 * and a wrong one reveals nothing by timing. `prefix` is the first few
 * characters of the secret: enough for an operator to tell two keys apart in
 * the dashboard or in a log line, useless to anyone who finds it.
 *
 * A key belongs to exactly one workspace and cannot be pointed at another,
 * which is what makes it safe to accept in place of a session.
 */
model ApiKey {
  id     String     @id @default(cuid())
  name   String
  /// Displayable head of the secret, e.g. `lipi_sk_a1b2c3d4`. Never the secret.
  prefix String
  /// SHA-256 of the whole secret, hex. Unique so a presented key resolves in one read.
  hash   String     @unique
  scopes ApiScope[] @default([read])

  createdAt DateTime @default(now())
  /// Coalesced, written behind the response — never inside a request's own transaction.
  lastUsedAt DateTime?
  /// Optional. A key with no expiry lives until it is revoked.
  expiresAt  DateTime?
  revokedAt  DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, revokedAt])
  @@map("api_keys")
}

/**
 * Where a workspace wants its twin events delivered.
 *
 * The event log is already the record of every mutation, so outbound
 * integration is a *reader* of it rather than a second stream — nothing here
 * writes a `TwinEvent`, and nothing here may update one (invariant 6). What a
 * subscription owns is its own position in that log and its own delivery
 * attempts, both of which live outside the event.
 *
 * `secret` is the signing secret, encrypted at rest through `lib/crypto` like
 * a channel credential. It is shown once at creation; no endpoint returns it
 * again, because a signature the subscriber can verify is only worth anything
 * while both sides are the only two who know the key.
 */
model WebhookSubscription {
  id     String  @id @default(cuid())
  url    String
  /// Exact `TwinEvent.type` values this endpoint wants. Empty means every
  /// type, which is also the default: an integrator who has not said
  /// otherwise is better served by too much than by silence.
  eventTypes String[] @default([])
  /// AES-256-GCM ciphertext of the HMAC signing secret. Never returned.
  secret String
  /// Paused rather than deleted. A subscription that is off stops receiving
  /// but keeps its cursor, so resuming does not replay a month of events.
  active Boolean @default(true)

  /// Position in the append-only log: the `occurredAt` of the newest event
  /// already queued, with `cursorId` as the tiebreak that makes the order
  /// total. Set to the moment of creation, so a new endpoint starts with
  /// what happens next rather than with the whole history.
  cursorAt DateTime
  cursorId String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  deliveries WebhookDelivery[]

  @@index([workspaceId])
  @@index([active])
  @@map("webhook_subscriptions")
}

enum WebhookDeliveryStatus {
  /// Queued, or waiting out a backoff. `nextAttemptAt` says when it is due.
  pending
  /// The endpoint answered 2xx. Terminal unless an operator redelivers.
  delivered
  /// Attempts exhausted. Terminal, and the thing an operator has to look at.
  dead
}

/**
 * One event owed to one subscription.
 *
 * Delivery is at-least-once: the row is queued before it is attempted, and an
 * attempt that fails ambiguously (a timeout, a 500 after the handler ran) is
 * retried. `eventId` is the `TwinEvent` id and travels in the body, so the
 * subscriber de-duplicates on it exactly as `ProcessedMessage` lets us
 * de-duplicate an inbound provider retry.
 *
 * `@@unique([subscriptionId, eventId])` is what makes the queue idempotent:
 * a second enqueue pass over the same events cannot owe an endpoint the same
 * event twice, whatever the cursor did.
 */
model WebhookDelivery {
  id String @id @default(cuid())

  /// The `TwinEvent` this carries. Not a foreign key: events are evidence and
  /// a delivery must never be able to cascade one away.
  eventId   String
  eventType String

  status        WebhookDeliveryStatus @default(pending)
  attempts      Int                   @default(0)
  /// When this becomes due. Backoff is expressed by pushing it forward.
  nextAttemptAt DateTime
  /// What the endpoint last answered — a status code, or null for a transport
  /// failure, where `lastError` carries the reason instead.
  lastStatus    Int?
  lastError     String?
  lastAttemptAt DateTime?
  deliveredAt   DateTime?

  createdAt DateTime @default(now())

  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([workspaceId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

enum ModelPurpose {
  /// Turning one customer message into structured intent (`services/extract.ts`).
  extract
  /// Voicing a reply whose facts `ingest()` already decided (`services/selling.ts`).
  sell
  /// The operator asking their own twin about the business (`services/twin-chat.ts`).
  twin_chat
}

/**
 * One call to OpenRouter, whatever became of it.
 *
 * Written by `lib/openrouter.ts` itself rather than by its callers, so a
 * fourth model-backed path cannot be added without being metered: the row is
 * appended on the way out of `chatCompletion()`, on the success path and on
 * every failure path alike. A call that timed out or came back 402 still cost
 * latency and may still have cost tokens, and a budget that only counted the
 * calls that worked would be blind to exactly the workspace that is being
 * ground through its ceiling.
 *
 * No money column. OpenRouter prices in fractional US dollars, and converting
 * that to a rupee figure needs an FX rate nobody here has — so spend is
 * metered in the units the response actually reports, calls and tokens, and
 * invariant 4 is kept by storing no money at all rather than by rounding one.
 */
model ModelCall {
  id String @id @default(cuid())

  purpose ModelPurpose
  /// The model as asked for, not as routed: OpenRouter may serve a request
  /// from any provider behind the id, and the id is what the budget was set
  /// against.
  model   String

  /// Tokens as reported by the response. Null when there was no response to
  /// report them — a timeout, a transport failure, a non-2xx body.
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  /// Wall clock for the whole call, including the time a timeout waited.
  latencyMs Int
  /// False means the caller fell back to its deterministic path.
  ok        Boolean
  /// Why it failed, truncated. Null when it succeeded.
  error     String?

  occurredAt DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The customer twin whose thread spent this call, which is the unit the
  /// per-conversation cap counts — a `Conversation` row here is one inbound
  /// message, so it is the customer that persists across a back-and-forth.
  /// Null for twin chat, which has no customer, and for the very first
  /// message of a twin's life, where the row does not exist yet and no prior
  /// call can have been charged to it either.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@index([customerId, occurredAt])
  @@map("model_calls")
}

/**
 * Which pre-built agent a workspace started from, if any.
 *
 * The four the PRD names (§2 Step 01). `custom` is what an agent assembled
 * from skills by hand records, so "started from a template" and "was built
 * from scratch" are distinguishable afterwards — a template can change, and
 * an operator is entitled to know whether theirs was derived from one.
 */
enum AgentTemplate {
  customer_support
  sdr
  calendar_pa
  inbound_reception
  custom
}

/**
 * Where an agent is in its life. `draft` has never been published; `paused`
 * was published and is currently answering nothing. Deleting is not a state:
 * an agent that has run has runs, approvals and events pointing at it.
 */
enum AgentStatus {
  draft
  deployed
  paused
}

/**
 * A deployable agent: the unit the no-code builder creates and the SDK
 * registers.
 *
 * Before this existed a workspace had exactly one implicit agent, and which
 * "agent" had acted was a string literal chosen by a branch inside `ingest()`
 * ("Sales", "Inventory", "Procurement", "Support"). That is fine for a fixed
 * product and impossible for a builder, because there is nothing to configure,
 * nothing to deploy, and nothing for a guardrail to be attached to.
 *
 * What an agent owns, and why each lives here rather than on the workspace:
 *
 *  - `skills`     what it may do. This is the allowed-tool list, and it is
 *                 checked on every execution (`server/agents/execute.ts`).
 *                 A model that asks for a skill this agent does not hold is
 *                 refused before the arguments are even parsed.
 *  - `guardrails` the ceilings it may not cross and the words that always
 *                 fetch a human. Per agent, because an SDR negotiating
 *                 discounts and a reception agent booking appointments do not
 *                 want the same limits.
 *  - `channels`   where it answers. A workspace can connect WhatsApp without
 *                 every agent it owns being published there.
 *
 * `TwinVoice` and `KnowledgeEntry` stay on the workspace: how the business
 * sounds and what it may claim are properties of the business, not of one
 * agent, and duplicating them per agent is how two agents end up quoting
 * different return policies at the same customer.
 */
model Agent {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id       String        @id @default(cuid())
  name     String
  template AgentTemplate @default(custom)
  status   AgentStatus   @default(draft)

  /// What it says about itself. Never a place for numbers or policy — those
  /// are facts, and facts reach the model through the grounding block.
  description String?

  /// Where this agent is published. A subset of the workspace's connected
  /// channels; publishing to one that is not connected is refused at deploy.
  channels Channel[]

  /// The ceilings, validated against `agentGuardrailsSchema`
  /// (`server/agents/guardrails.ts`) on the way in, so a malformed object
  /// cannot be stored and then silently fail open at execution time.
  guardrails Json @default("{}")

  /// Which knowledge entries ground this agent. Empty means every entry the
  /// workspace has, which is the useful default and what the PRD's own
  /// `knowledge_base_ids` omission implies.
  knowledgeEntryIds String[] @default([])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deployedAt DateTime?

  skills AgentSkill[]
  runs   AgentRun[]

  /// One agent per name per tenant: the deploy endpoint is an upsert on this,
  /// so re-deploying an agent updates it rather than growing a second one
  /// with the same name and half the traffic.
  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("agents")
}

/**
 * One skill, enabled on one agent, with its own configuration.
 *
 * `skill` is a slug from the registry in `server/agents/registry.ts`, not a
 * foreign key: skills are code, they ship with a release, and a database row
 * per skill would let a tenant name one that has no implementation. A slug
 * that the registry does not know is refused at deploy.
 *
 * `enabled` rather than deletion, so turning a skill off for an afternoon
 * does not lose the configuration it was turned off with.
 */
model AgentSkill {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  skill   String
  config  Json    @default("{}")
  enabled Boolean @default(true)

  @@unique([agentId, skill])
  @@map("agent_skills")
}

/**
 * Where a calendar entry came from.
 *
 * `negotiated` is distinct from `manual` because it is the one the PA twin
 * created itself, and an operator reviewing what their assistant did to their
 * week is entitled to see which entries it put there.
 */
enum CalendarSource {
  google
  manual
  negotiated
  /// A block the owner never wants meetings in. Not a meeting; a refusal.
  focus
}

/**
 * How a scheduling conversation is going.
 *
 * The PRD's Personal PA Twin stores "active scheduling negotiations" (§5),
 * which is only meaningful if a negotiation is a thing that persists between
 * turns — a proposal sent on Monday and answered on Tuesday is one
 * negotiation, not two messages.
 */
enum NegotiationState {
  proposed
  countered
  confirmed
  abandoned
}

/**
 * The Personal PA Twin (PRD §5).
 *
 * Owner focus blocks, max daily meeting hours, buffer rules and a fatigue
 * index — the constraints a scheduling decision is made against. They live on
 * a row rather than in a prompt for the same reason every other number in this
 * codebase does: a model asked to "keep a reasonable buffer" will eventually
 * keep none, and the owner finds out by walking into a meeting they were
 * already late for.
 *
 * One profile per named owner per workspace, because a business has several
 * people whose calendars mean different things, and merging them would make
 * "is this slot free" unanswerable.
 */
model PaProfile {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id        String @id @default(cuid())
  ownerName String
  /// IANA zone. Every stored instant is UTC; this is what "avoid mornings"
  /// is resolved against, and getting it from the row rather than the server
  /// is the difference between a 9am meeting and a 3am one.
  timezone  String @default("UTC")

  /// The working window, in minutes from local midnight.
  workdayStartMinute Int @default(540)
  workdayEndMinute   Int @default(1080)

  /// PRD §5: "buffer rules (15 min)". Held either side of every booking.
  bufferMinutes Int @default(15)

  /// PRD §5: "max daily meeting hours", stored in minutes so it composes with
  /// everything else here without a unit conversion at the point of use.
  maxDailyMeetingMinutes Int @default(300)

  /// Recurring blocks the owner will not take meetings in, as
  /// `[{ weekday, startMinute, endMinute, label }]` with weekday 0 = Sunday.
  focusBlocks Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events       CalendarEvent[]
  negotiations SchedulingNegotiation[]

  @@unique([workspaceId, ownerName])
  @@index([workspaceId])
  @@map("pa_profiles")
}

/**
 * One entry on a PA twin's calendar.
 *
 * Instants are stored UTC and compared UTC. `externalId` is the provider's
 * own id where the entry came from one, so a re-sync updates rather than
 * duplicates — the same idempotency rule the channel adapters keep on
 * provider message ids.
 */
model CalendarEvent {
  workspaceId String

  id        String @id @default(cuid())
  profileId String
  profile   PaProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  externalId String?
  title      String
  startsAt   DateTime
  endsAt     DateTime
  source     CalendarSource @default(manual)
  /// False for an entry that is on the calendar but does not block it — a
  /// tentative hold, an all-day marker.
  busy       Boolean        @default(true)

  createdAt DateTime @default(now())

  negotiation SchedulingNegotiation?

  @@unique([profileId, externalId])
  @@index([profileId, startsAt])
  @@index([workspaceId])
  @@map("calendar_events")
}

/**
 * A multi-turn scheduling negotiation, as a row.
 *
 * "Find 45 minutes with Dr. Chen next week, avoid mornings, keep 15-minute
 * buffers" is not one request and one answer — it is a proposal, possibly a
 * counter, and a confirmation, spread over hours and arriving on whichever
 * channel the counterpart prefers. The constraints are parsed once, at the
 * start, and every later turn is decided against the stored ones rather than
 * re-read out of prose that may not be repeated.
 */
model SchedulingNegotiation {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id        String @id @default(cuid())
  profileId String
  profile   PaProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Who the meeting is with. A name, because the counterpart may have no
  /// account and no twin — the PRD's own example is a doctor.
  counterpartName   String
  counterpartHandle String?

  durationMinutes Int
  purpose         String

  /// The parsed constraints, validated by `schedulingConstraintsSchema`
  /// (`server/agents/scheduling.ts`): windows to avoid, earliest and latest
  /// acceptable dates, whether buffers are required.
  constraints Json @default("{}")

  state NegotiationState @default(proposed)

  /// The slots offered, newest proposal last, as
  /// `[{ startIso, endIso, offeredAt }]`. Kept so a counter-offer can be
  /// checked against what was actually put on the table.
  proposedSlots Json @default("[]")

  agreedStart DateTime?
  agreedEnd   DateTime?

  /// The calendar entry this negotiation produced, once it confirmed.
  eventId String?        @unique
  event   CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, state])
  @@index([profileId, state])
  @@map("scheduling_negotiations")
}

/**
 * Where a generated site has got to.
 *
 * `generated` has a structure and no deployment; `deployed` has both. There is
 * no `deploying` — a deployment either produced a URL or it did not, and a
 * state that means "we are not sure" is a state somebody has to poll.
 */
enum SiteStatus {
  generated
  deployed
  failed
}

/**
 * A site generated from a business profile (PRD §3).
 *
 * The three phases of §3 map onto three columns rather than three tables:
 * `structure` is Phase 1's output, the bindings inside it are Phase 2, and
 * `deployment` is Phase 3's.
 *
 * **The structure holds no business data.** A catalogue block names the
 * catalogue; it does not carry products. A quote block holds the formula's
 * source; it does not carry prices. Everything is resolved against live rows
 * when a page is rendered, so a generated site cannot show a price that was
 * true at generation and is not true now — which is the whole of "dynamic
 * twin binding … without manual SQL migrations or backend glue code".
 */
model GeneratedSite {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  id   String @id @default(cuid())
  /// The path this site is served at under `/s/`. Derived from the business
  /// name, unique per deployment because it is a public URL.
  slug String @unique
  name String

  /// The PRD's `business_profile`, `site_features` and `deployment_target`,
  /// stored as sent so a regenerate is reproducible from the original ask.
  profile    Json
  features   Json
  deployment Json

  /// Phase 1's output, including the Phase 2 bindings. Validated against
  /// `SiteStructure` on the way in.
  structure Json

  /// The quote expression's source, lifted out of `features` because the
  /// renderer reads it on every quote and a column beats a JSON path.
  quoteFormula String?

  status SiteStatus @default(generated)
  /// Where it went live, when it did. Null until a provider says otherwise.
  liveUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, createdAt])
  @@map("generated_sites")
}
